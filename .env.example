# منصة التوفيق — Environment Variables

# ============================================================
# DATABASE
# ============================================================
MONGODB_URI=mongodb://localhost:27017/tawfeek

# ============================================================
# JWT AUTHENTICATION
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-64-chars
JWT_EXPIRES_IN=7d

# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=منصة التوفيق

# ============================================================
# OTP / SMS PROVIDER
# Choose: twilio | vonage | mock
# ============================================================
SMS_PROVIDER=mock

# --- Twilio ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --- Vonage (Nexmo) ---
VONAGE_API_KEY=your_vonage_api_key
VONAGE_API_SECRET=your_vonage_api_secret
VONAGE_FROM=Tawfeek

# ============================================================
# GAMIFICATION DEFAULTS (overridable in Admin Settings)
# ============================================================
DEFAULT_LESSON_WATCH_POINTS=5
DEFAULT_LESSON_COMPLETE_POINTS=10
DEFAULT_QUIZ_COMPLETE_POINTS=10
DEFAULT_WEEKLY_EXAM_POINTS=50
DEFAULT_MONTHLY_EXAM_POINTS=100
DEFAULT_REFERRAL_POINTS=30
DEFAULT_STREAK_BONUS=5

# ============================================================
# FREE STUDENT LIMIT
# ============================================================
FREE_STUDENT_LIMIT=100

# ============================================================
# VIDEO COMPLETION THRESHOLD (percentage)
# ============================================================
VIDEO_COMPLETION_THRESHOLD=90

# ============================================================
# OTP SETTINGS
# ============================================================
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MINUTES=60
OTP_MAX_REQUESTS_PER_HOUR=5

# ============================================================
# RATE LIMITING
# ============================================================
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=900

# ============================================================
# ADMIN SEEDING (Development only)
# ============================================================
ADMIN_SEED_PHONE=01000000000
ADMIN_SEED_PASSWORD=Admin@123456
ADMIN_SEED_NAME=مدير المنصة
